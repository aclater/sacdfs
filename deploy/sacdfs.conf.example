# Settings for the sacdfs systemd unit and for sacdfs-ctl.
# Copy to /etc/default/sacdfs and change the paths. One setting per line, no spaces
# around the equals sign, no $variables (systemd reads this file too).
SACDFS_IMAGES=/volume1/music
SACDFS_MOUNT=/volume1/sacd
# Extra options, separated by spaces: see docs/options.md.
SACDFS_OPTIONS="--allow-other"
# Where a NAS start-up tool runs sacdfs-ctl there may be no HOME, and sacdfs then logs
# "no seek index cache". Name a folder for it, for example:
#SACDFS_OPTIONS="--allow-other --index-cache /volume1/sacdfs/cache"
# sacdfs-ctl only (the systemd unit uses the journal):
#SACDFS_BIN=/usr/local/bin/sacdfs
#SACDFS_PIDFILE=/var/run/sacdfs.pid
#SACDFS_LOG=/var/log/sacdfs.log
